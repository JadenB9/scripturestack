# Copy to .env.local. Never commit .env.local.

# Postgres with pgvector. On Vercel the Neon integration injects this.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Unpooled URL for drizzle-kit (schema push/generate). Optional locally.
DATABASE_URL_UNPOOLED=

# scripturestack-ml embedding service (Railway)
ML_API_URL=https://your-ml-service.up.railway.app
ML_API_KEY=

# Crossway ESV API — https://api.esv.org/
ESV_API_KEY=

# Mapbox public token (pk.…) — https://account.mapbox.com/access-tokens/
# Scope it to your origins; it ships to the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=
